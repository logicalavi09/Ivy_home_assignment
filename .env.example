# Required by api/proxy.js (Vercel Serverless Function).
# Copy this file to .env and fill in the real key. .env is gitignored.
# For Vercel production, run: vercel env add IVY_API_KEY
IVY_API_KEY=

# Optional. Restrict CORS origins (comma-separated). Defaults to "*" for local dev.
# ALLOWED_ORIGIN=*